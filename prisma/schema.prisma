generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String?
  image        String?
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  profile      CareerProfile?
  preferences  JobPreferences?
  applications Application[]
  sessions     Session[]
  gmailConnection GmailConnection?
  emailSignals  EmailSignal[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model CareerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  atsScore    Int      @default(0)
  headline    String?
  location    String?
  summary     String   @default("")
  skills      Json
  targetRoles Json
  experience  Json
  education   Json
  strengths   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobPreferences {
  id         String   @id @default(cuid())
  userId     String   @unique
  roles      String   @default("")
  locations  String   @default("")
  workMode   String   @default("Any")
  seniority  String   @default("Any")
  minSalary  String   @default("")
  keywords   String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id           String        @id
  title        String
  company      String
  location     String
  mode         String?
  level        String?
  source       String?
  salary       String?
  url          String?
  description  String?
  skills       Json
  firstSeenAt  DateTime      @default(now())
  lastSeenAt   DateTime      @updatedAt
  applications Application[]
  emailSignals EmailSignal[]
}

model Application {
  id                 String                @id @default(cuid())
  userId             String
  jobId              String
  status             String                @default("Saved")
  notes              String                @default("")
  appliedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  job                Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tailoredApplication TailoredApplication?
  emailSignals       EmailSignal[]
  @@unique([userId, jobId])
  @@index([userId, status])
}

model TailoredApplication {
  id                  String       @id @default(cuid())
  applicationId       String       @unique
  tailoredSummary     String
  resumeEdits         Json
  coverLetter         String
  missingRequirements Json
  recommendation      String
  template            String       @default("classic")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  application         Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model GmailConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  provider     String   @default("google")
  email        String?
  refreshToken String
  scope        String
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailSignal {
  id              String   @id @default(cuid())
  userId          String
  jobId           String?
  applicationId   String?
  gmailMessageId  String
  threadId        String?
  sender          String?
  subject         String?
  receivedAt      DateTime?
  category        String
  confidence      Float
  suggestedStatus String?
  reason          String
  recruiterName   String?
  recruiterEmail  String?
  matchedScore    Float?
  matchMethod     String?
  ambiguous       Boolean  @default(false)
  applied         Boolean  @default(false)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  application     Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  @@unique([userId, gmailMessageId])
  @@index([userId, category])
  @@index([applicationId])
}

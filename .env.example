# Server-side OpenAI API key. Never commit the real key.
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL connection string for Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jobpilot

# Comma-separated public Lever company slugs for real job discovery.
# Example: companyone,companytwo
JOBPILOT_LEVER_COMPANIES=

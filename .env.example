# Server-side OpenAI API key. Never commit the real key.
OPENAI_API_KEY=your_openai_api_key_here
# Optional OpenAI model override used by the fallback provider.
OPENAI_AI_MODEL=gpt-5.6-luna

# Modal OpenAI-compatible inference. If configured, JobPilot tries Modal first and falls back to OpenAI.
# For Modal Shared Endpoints, use https://api.modal.com/v1 and your Modal API key.
# For a dedicated endpoint, use its OpenAI-compatible /v1 URL instead.
MODAL_AI_API_KEY=
MODAL_AI_BASE_URL=https://api.modal.com/v1
MODAL_AI_MODEL=auto

# PostgreSQL connection string for Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jobpilot

# Comma-separated public Lever company slugs for live job discovery.
JOBPILOT_LEVER_COMPANIES=

# Comma-separated public Greenhouse board tokens for live job discovery.
JOBPILOT_GREENHOUSE_BOARDS=

# Google OAuth for Gmail read-only integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=

# Payments stay disabled until explicitly enabled after testing.
JOBPILOT_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Public canonical app URL. Use HTTPS in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

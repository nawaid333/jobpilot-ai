# Server-side OpenAI API key. Never commit the real key.
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL connection string for Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jobpilot

# Comma-separated public Lever company slugs for real job discovery.
JOBPILOT_LEVER_COMPANIES=

# Google OAuth for Gmail read-only integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=

# Stripe billing. Create a recurring Pro price in Stripe and use its price ID here.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

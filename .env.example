# Server-side OpenAI API key. Never commit the real key.
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL connection string for Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jobpilot

# Comma-separated public job-board slugs for live discovery.
# Example: Lever=company-slug, Greenhouse=board-token, Ashby=board-name.
JOBPILOT_LEVER_COMPANIES=
JOBPILOT_GREENHOUSE_COMPANIES=
JOBPILOT_ASHBY_BOARDS=

# Google OAuth for Gmail read-only integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=

# Payments stay disabled until explicitly enabled after testing.
JOBPILOT_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Public canonical app URL. Use HTTPS in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
